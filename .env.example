# Copy to .env.local. Public values come from the selected Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin for confirmation/recovery links; no trailing slash.
# Set the deployed preview origin in Vercel Preview; real domain in Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by financial/email workers from Phase 5; server-only secret key.
# Never prefix this with NEXT_PUBLIC_ or put it in a browser/client component.
SUPABASE_SECRET_KEY=

# Stripe configuration and commercial terms remain unset until owner approval.
STRIPE_RESTRICTED_KEY=
STRIPE_ENVIRONMENT=sandbox
# Live host verification and guest charging are separately activated.
STRIPE_LIVE_ONBOARDING_ENABLED=false
STRIPE_LIVE_PAYMENTS_ENABLED=false
STRIPE_WEBHOOK_SECRET_PLATFORM=
STRIPE_WEBHOOK_SECRET_CONNECT=
STRIPE_WEBHOOK_SECRET_ACCOUNTS_V2=

# Authenticates scheduled reconciliation and email worker endpoints.
# Use at least 32 random characters; never expose this to a browser.
CRON_SECRET=

# Transactional email stays off until a domain-authenticated sender is ready.
TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Optional public contact mailbox, read only on the server. Set after mailbox setup.
# A valid address appears as an email link on Contact and in the footer.
CONTACT_EMAIL=
