# Copy to .env.local. Public values come from the selected Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin for confirmation/recovery links; no trailing slash.
# Set the deployed preview origin in Vercel Preview; real domain in Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No service-role key is needed by Phase 1. Never add one to NEXT_PUBLIC_*.
# Stripe, email, and commission settings will be added in their approved phases.
